# Copy to .env and fill in. Every setting is read by backend/app/config.py.

# Required in production: a random string of at least 32 characters.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ENVIRONMENT=production

# SQLite by default (one process). docker-compose.yml sets PostgreSQL for you.
# DATABASE_URL=postgresql://user:password@host:5432/waypoint
# DATA_DIR=/data

# Only when the web app is served from another origin than the API.
# CORS_ORIGINS=https://example.org

# Optional: the official YouTube Data API (likes, upload dates, comment sentiment).
# Without a key, yt-dlp is used.
# YOUTUBE_API_KEY=
# YOUTUBE_PROXY=http://user:pass@proxy:port
# YOUTUBE_REQUEST_INTERVAL=1.0

# Optional: Google Vision for handwritten notes (otherwise RapidOCR).
# GOOGLE_VISION_API_KEY=

# Videos without usable captions (none, refused by YouTube, or in a language the
# model cannot read) are listened to on this machine, after the path is first built.
# Needs ffmpeg; takes about as long as the video on CPU. On by default.
# ASR_ENABLED=false turns it off (small servers). ASR_MODEL: tiny, base, small, medium.
# ASR_ENABLED=true
# ASR_MODEL=small
# ASR_MAX_MINUTES=180

# Models. Set RERANKER_MODEL= (empty) on hosts with under ~1.5 GB of memory.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Run the job worker inside the API process (one process). Set to false and run
# `python -m app.worker` separately when running several API processes.
# RUN_WORKER=true
